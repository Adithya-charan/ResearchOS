# Copy to .env (never commit .env). RESEARCHOS makes no hosted-AI calls, so there are no API keys here.
RESEARCHOS_ARTIFACT_DIR=artifacts
RESEARCHOS_DATASET_DIR=datasets
# Keep caches off a small system drive, e.g.:
# PIP_CACHE_DIR=E:\pip-cache

# API settings (all optional; see api/config.py)
# RESEARCHOS_DATABASE_URL=sqlite:///artifacts/api/researchos.db
# RESEARCHOS_ALLOWED_ORIGINS=http://localhost:3000
# RESEARCHOS_COOKIE_SECURE=true          # behind TLS
# RESEARCHOS_EMBEDDED_WORKER=true       # false = run jobs only in scripts/run_worker.py processes
# RESEARCHOS_TRAINING_ENABLED=false      # let users start training jobs on this host
# RESEARCHOS_ALLOW_WEAK_SANDBOX=false    # NON-isolating experiment fallback: development only
