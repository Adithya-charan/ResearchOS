# Copy to .env (never commit .env). RESEARCHOS makes no hosted-AI calls, so there are no API keys here.
RESEARCHOS_ARTIFACT_DIR=artifacts
RESEARCHOS_DATASET_DIR=datasets
# Keep caches off a small system drive, e.g.:
# PIP_CACHE_DIR=E:\pip-cache

# API settings (all optional; see api/config.py)
# RESEARCHOS_DATABASE_URL=sqlite:///artifacts/api/researchos.db
# RESEARCHOS_ALLOWED_ORIGINS=http://localhost:3000
# RESEARCHOS_COOKIE_SECURE=true          # behind TLS
# RESEARCHOS_EMBEDDED_WORKER=true       # false = run jobs only in scripts/run_worker.py processes
# RESEARCHOS_TRAINING_ENABLED=false      # let users start training jobs on this host
# RESEARCHOS_ALLOW_WEAK_SANDBOX=false    # NON-isolating experiment fallback: development only

# --- PostgreSQL (docker-compose.postgres.yml; see docs/DATABASE.md) ---------------------------------------------------------------
# Credentials for the compose postgres service. There is deliberately no default password; use URL-safe characters only (it is embedded
# in the connection URL):  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=researchos
POSTGRES_DB=researchos
POSTGRES_PASSWORD=
# Outside Docker:   RESEARCHOS_DATABASE_URL=postgresql://user:password@host:5432/researchos   (API schema "api", engine schema "engine")
#                   RESEARCHOS_ENGINE_DATABASE_URL=postgresql://...                            (optional: engine in another database)
# RESEARCHOS_DB_POOL_SIZE=10
# RESEARCHOS_DB_MAX_OVERFLOW=20

# --- Production (docker-compose.prod.yml; see docs/DEPLOYMENT.md) -----------------------------------------------------------------
# Required: the exact public https origin(s) of the site (comma separated, no wildcards).
RESEARCHOS_ALLOWED_ORIGINS=
# Secure cookie + HSTS are ON by default in the production file; for a local http trial set both to false.
# RESEARCHOS_COOKIE_SECURE=true
# RESEARCHOS_HSTS=true
# RESEARCHOS_TRUSTED_PROXIES=127.0.0.1        # the reverse proxy's address as the API sees it
# RESEARCHOS_ADMIN_EMAILS=                    # comma separated
# RESEARCHOS_ENABLE_DOCS=false                # Swagger UI / OpenAPI schema
# RESEARCHOS_PORT=8000                        # loopback port the API is published on
# RESEARCHOS_WORKER_CONCURRENCY=2
# RESEARCHOS_LOG_LEVEL=info
# Limits (see docs/DEPLOYMENT.md): RESEARCHOS_MAX_UPLOAD_BYTES, RESEARCHOS_MAX_DOCUMENTS_PER_PROJECT, RESEARCHOS_MAX_CORPUS_BYTES,
#   RESEARCHOS_SESSION_TTL_S, RESEARCHOS_MIN_PASSWORD_LENGTH, RESEARCHOS_MAX_ACTIVE_RUNS_PER_USER, RESEARCHOS_SSE_MAX_STREAMS_PER_USER
# Per-user rate limits, "count/window_seconds" or "off" (defaults in docs/SECURITY.md):
#   RESEARCHOS_RATE_UPLOAD, RESEARCHOS_RATE_RUN_CREATE, RESEARCHOS_RATE_SEARCH, RESEARCHOS_RATE_VERIFY, RESEARCHOS_RATE_REPORT,
#   RESEARCHOS_RATE_EXPERIMENT, RESEARCHOS_RATE_EVALUATE, RESEARCHOS_RATE_REPROCESS
